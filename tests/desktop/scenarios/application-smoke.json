{
  "schema_version": 1,
  "id": "desktop/application-smoke-v1",
  "profile_id": "pe/amd64/no-multilib/systemd/desktop-verifier-v1",
  "image_id": "pe/amd64/no-multilib/desktop-verifier-g3",
  "resolution": "1280x720",
  "locale": "C.UTF-8",
  "timeout_seconds": 900,
  "steps": [
    {"id": "restore-clean", "action": "restore", "input": {"snapshot": "clean"}},
    {"id": "start-vm", "action": "start", "timeout_seconds": 300},
    {"id": "install-artifact", "action": "install", "timeout_seconds": 300, "input": {"atom": "app-editors/gvim", "staging_digest": "sha256:replace-with-reviewed-staging-digest"}},
    {"id": "launch-application", "action": "launch", "input": {"application_id": "gvim.desktop"}},
    {"id": "wait-main-window", "action": "wait_accessible", "input": {"role": "frame", "name": "GVim", "state": "visible"}},
    {"id": "capture-accessibility", "action": "collect_accessibility", "input": {"name": "gvim-accessibility-tree"}},
    {"id": "capture-main-window", "action": "screenshot", "input": {"name": "gvim-main-window"}},
    {"id": "collect-journal", "action": "collect_logs", "input": {"scope": "application", "application_id": "gvim.desktop"}},
    {"id": "stop-vm", "action": "stop", "timeout_seconds": 120}
  ]
}
