{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::portage-drill-artifacts"
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::portage-drill-artifacts/drills/recovery/.channels/*",
        "arn:aws:s3:::portage-drill-artifacts/drills/recovery/.generations/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::portage-drill-artifacts/drills/recovery/.generations/*"
    }
  ]
}
