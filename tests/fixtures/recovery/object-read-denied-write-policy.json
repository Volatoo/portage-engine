{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:GetObjectVersion"],
      "Resource": [
        "arn:aws:s3:::portage-drill-artifacts",
        "arn:aws:s3:::portage-drill-artifacts/drills/recovery/.channels/*",
        "arn:aws:s3:::portage-drill-artifacts/drills/recovery/.generations/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::portage-drill-artifacts/*"
    }
  ]
}
