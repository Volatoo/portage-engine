{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::portage-drill-artifacts",
        "arn:aws:s3:::portage-drill-artifacts/drills/recovery/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::portage-drill-artifacts/drills/recovery/.quarantine/*"
    }
  ]
}
