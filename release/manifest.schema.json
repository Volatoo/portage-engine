{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slchris/portage-engine/blob/main/release/manifest.schema.json",
  "title": "Portage Engine canonical release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "registry",
    "images",
    "binaries",
    "checksums",
    "transition"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "operation",
        "source_repository",
        "source_commit",
        "source_ref",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$"
        },
        "channel": {
          "enum": [
            "candidate",
            "stable"
          ]
        },
        "operation": {
          "enum": [
            "build",
            "promotion",
            "rollback"
          ]
        },
        "source_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/[0-9A-Za-z][0-9A-Za-z._/-]*$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "namespace",
        "release_repository"
      ],
      "properties": {
        "host": {
          "const": "ghcr.io"
        },
        "namespace": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/[a-z0-9_.-]+$"
        },
        "release_repository": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/[a-z0-9_.-]+/releases$"
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "target",
          "repository",
          "digest",
          "reference",
          "platforms",
          "sbom",
          "provenance"
        ],
        "properties": {
          "role": {
            "$ref": "#/$defs/name"
          },
          "target": {
            "$ref": "#/$defs/name"
          },
          "repository": {
            "type": "string"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "reference": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ]
            }
          },
          "sbom": {
            "$ref": "#/$defs/file"
          },
          "provenance": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "binaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "os",
          "arch",
          "path",
          "sha256"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "os": {
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "arch": {
            "enum": [
              "amd64",
              "arm64"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binaries",
        "evidence"
      ],
      "properties": {
        "binaries": {
          "$ref": "#/$defs/file"
        },
        "evidence": {
          "$ref": "#/$defs/file"
        }
      }
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "build"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "candidate_manifest_digest",
            "candidate_oci_digest",
            "expected_previous_stable_manifest_digest",
            "expected_previous_stable_oci_digest"
          ],
          "properties": {
            "type": {
              "const": "promotion"
            },
            "candidate_manifest_digest": {
              "$ref": "#/$defs/digest"
            },
            "candidate_oci_digest": {
              "$ref": "#/$defs/digest"
            },
            "expected_previous_stable_manifest_digest": {
              "oneOf": [
                {
                  "const": "none"
                },
                {
                  "$ref": "#/$defs/digest"
                }
              ]
            },
            "expected_previous_stable_oci_digest": {
              "oneOf": [
                {
                  "const": "none"
                },
                {
                  "$ref": "#/$defs/digest"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "target_manifest_digest",
            "target_oci_digest",
            "expected_previous_stable_manifest_digest",
            "expected_previous_stable_oci_digest",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "rollback"
            },
            "target_manifest_digest": {
              "$ref": "#/$defs/digest"
            },
            "target_oci_digest": {
              "$ref": "#/$defs/digest"
            },
            "expected_previous_stable_manifest_digest": {
              "$ref": "#/$defs/digest"
            },
            "expected_previous_stable_oci_digest": {
              "$ref": "#/$defs/digest"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
