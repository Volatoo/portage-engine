# Keep the Gentoo test environment while decoupling the security patch level of
# the compiler from Gentoo keywording. The same upstream toolchain builds the
# production binaries in Dockerfile.
FROM golang:1.26.6@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS go-toolchain

# Test stage - Gentoo base with portage tree synced
FROM gentoo/stage3:latest@sha256:08914e15d306bfdb251262ca3f7e3489b77ca32604ad1928cbb21dc94587261c

COPY --from=go-toolchain /usr/local/go /usr/local/go

WORKDIR /app

ENV PATH="/usr/local/go/bin:/app/bin:${PATH}"
ENV GOPATH=/go
ENV CGO_ENABLED=1

# Disable sandboxing features that don't work well in containers
RUN echo 'FEATURES="-pid-sandbox -network-sandbox -ipc-sandbox -mount-sandbox"' >> /etc/portage/make.conf

# Sync portage tree and install build dependencies
RUN emerge-webrsync && \
    emerge -q \
    dev-vcs/git \
    dev-libs/libgpg-error \
    app-crypt/gnupg && \
    emerge --info

# Copy source code
COPY . .

# Download Go dependencies
RUN go mod download

# Create directories that might be needed
RUN mkdir -p /var/lib/portage-engine /tmp/portage-work /tmp/portage-artifacts && \
    chmod 777 /var/lib/portage-engine /tmp/portage-work /tmp/portage-artifacts

# Verify emerge is available
RUN which emerge && emerge --version

# Default test command (can be overridden)
CMD ["go", "test", "-v", "-race", "-coverprofile=coverage.out", "./..."]
