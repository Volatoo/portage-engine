[Unit]
Description=Portage Engine persistent capacity executor
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/portage-engine/executor.conf

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/usr/local/libexec/portage-engine/capacity-executor-identity
EnvironmentFile=/etc/portage-engine/executor.env
# executor.conf is provisioned only at boot and is already the application's
# root-owned runtime configuration. Export it as the process environment too
# so standard credential chains (notably the AWS SDK used for S3) can consume
# AWS_* and workload-identity settings without baking them into executor.env.
EnvironmentFile=/etc/portage-engine/executor.conf
EnvironmentFile=-/run/portage-engine/capacity-executor.env
ExecStart=/usr/local/bin/portage-server -config /etc/portage-engine/executor.conf
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
