[Unit]
Description=Portage Engine persistent capacity executor
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/portage-engine/executor.conf

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/usr/local/libexec/portage-engine/capacity-executor-identity
EnvironmentFile=/etc/portage-engine/executor.env
EnvironmentFile=/run/portage-engine/capacity-executor.env
ExecStart=/usr/local/bin/portage-server -config /etc/portage-engine/executor.conf
Restart=on-failure
RestartSec=10s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
