# Non-secret Public Beta edge inputs. Keep credentials in the deployment
# secret provider and export them only to the process running Compose/Gates.
PORTAGE_PUBLIC_HOST=portage.example.org
PORTAGE_API_HOST=api.portage.example.org
PORTAGE_METRICS_HOST=metrics.portage.example.org
PORTAGE_PUBLIC_HTTP_BIND=0.0.0.0
PORTAGE_PUBLIC_HTTPS_BIND=0.0.0.0
# Set PORTAGE_EDGE_IMAGE to a deployment-reviewed nginx image pinned by digest.
# Do not copy a placeholder digest from documentation.
# Set PORTAGE_WORKER_GATEWAY_BIND to one exact private/VLAN interface address.
# The edge overlay has no public/default value for this mTLS listener.

# Required identity/session policy (example durations, not credentials).
PORTAGE_AUTH_PROVIDERS_PATH=/etc/portage-engine/configs/auth-providers.json
PORTAGE_OIDC_SESSION_IDLE_MINUTES=60
PORTAGE_OIDC_SESSION_MAX_MINUTES=720
PORTAGE_OIDC_STEP_UP_MAX_AGE_MINUTES=10
PORTAGE_CORS_ALLOWED_ORIGINS=https://portage.example.org

# Do not put these values in this file:
# PORTAGE_AUTHENTIK_CLIENT_SECRET
# PORTAGE_GOOGLE_CLIENT_SECRET
# PORTAGE_GITHUB_CLIENT_SECRET
# PORTAGE_DASHBOARD_JWT_SECRET
# PORTAGE_METRICS_PASSWORD
